# Watchtower-Lite unified runtime configuration.
# Copy this file to .env, then fill in LLM_API_KEY. Never commit the real key.

# Local service ports and addresses
WATCHTOWER_WEB_PORT=3000
WATCHTOWER_PORT=8080
WATCHTOWER_BRAIN_ADDR=127.0.0.1:50052
WATCHTOWER_MOCK_CONTROL_URL=http://127.0.0.1:8081
WATCHTOWER_DB_PATH=data/watchtower.db
BRAIN_GRPC_PORT=50052
MOCK_PROMETHEUS_PORT=9090
MOCK_K8S_PORT=8081
MOCK_PROMETHEUS_URL=http://127.0.0.1:9090
MOCK_K8S_URL=http://127.0.0.1:8081

# DeepSeek (OpenAI-compatible API)
LLM_ENABLED=true
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1200
AGENT_MAX_ITERATIONS=10
AUTOFIX_OBSERVE_SECONDS=5

# Historical incident semantic retrieval (OpenAI-compatible Embeddings API)
EMBEDDING_ENABLED=true
EMBEDDING_BASE_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_SIMILARITY_THRESHOLD=0.78
EMBEDDING_KEYWORD_FALLBACK=true
