FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY proto/ ./proto/
COPY brain/ ./brain/

# 生成 Python gRPC 代码
RUN python -m grpc_tools.protoc -I. --python_out=. --grpc_python_out=. proto/diagnosis.proto

WORKDIR /app/brain
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
EXPOSE 50052
CMD ["python", "server.py"]
