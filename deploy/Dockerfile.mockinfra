FROM golang:1.22-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o bin/mock-infra ./cmd/mock-infra

FROM alpine:3.21
RUN apk --no-cache add ca-certificates
WORKDIR /app
COPY --from=builder /app/bin/mock-infra /app/mock-infra
USER 10001:10001
EXPOSE 9090 8081
CMD ["./mock-infra"]
